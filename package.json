{
  "name": "shogiwoshiyou",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:design": "vite build --config vite.design.config.ts && mv dist/design/design.html dist/design/index.html",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:ox && pnpm test && pnpm build && pnpm build:design",
    "cf-typegen": "wrangler types",
    "deploy": "pnpm verify:wrangler && pnpm build && wrangler deploy",
    "dev": "vite dev",
    "lint": "eslint .",
    "lint:ox": "oxlint .",
    "preview": "pnpm build && vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:wrangler": "node scripts/check-wrangler-config.mjs"
  },
  "dependencies": {
    "@hono/zod-validator": "0.7.5",
    "@preact/signals": "2.9.1",
    "hono": "4.12.34",
    "preact": "10.29.2",
    "tsshogi": "2.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.39.0",
    "@cloudflare/workers-types": "4.20260529.1",
    "@eslint/js": "10.0.1",
    "@preact/preset-vite": "2.10.5",
    "@types/node": "24.10.1",
    "eslint": "10.4.1",
    "globals": "16.5.0",
    "oxlint": "1.67.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.0",
    "vite": "7.3.3",
    "vitest": "4.1.4",
    "wrangler": "4.95.0"
  },
  "packageManager": "pnpm@11.2.2"
}
